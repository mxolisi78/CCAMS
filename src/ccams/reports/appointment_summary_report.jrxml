<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports 
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="appointment_summary_report" pageWidth="595" pageHeight="842" 
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    
    <!-- Parameters -->
    <parameter name="clinicName" class="java.lang.String"/>
    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="startDate" class="java.lang.String"/>
    <parameter name="endDate" class="java.lang.String"/>
    <parameter name="generatedBy" class="java.lang.String"/>
    <parameter name="generatedAt" class="java.lang.String"/>
    <parameter name="totalAppointments" class="java.lang.Integer"/>
    <parameter name="pending" class="java.lang.Integer"/>
    <parameter name="approved" class="java.lang.Integer"/>
    <parameter name="completed" class="java.lang.Integer"/>
    <parameter name="cancelled" class="java.lang.Integer"/>
    
    <!-- Title -->
    <title>
        <band height="120">
            <!-- Header Border -->
            <rectangle>
                <reportElement x="0" y="0" width="555" height="120" />
                <graphicElement>
                    <pen lineWidth="1" lineColor="#1a53a8"/>
                </graphicElement>
            </rectangle>
            
            <!-- Clinic Name -->
            <staticText>
                <reportElement x="0" y="20" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="22" isBold="true" pdfFontName="Helvetica-Bold"/>
                </textElement>
                <text><![CDATA[CCAMS]]></text>
            </staticText>
            
            <!-- Report Title -->
            <textField>
                <reportElement x="0" y="55" width="555" height="25"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            
            <!-- Subtitle -->
            <staticText>
                <reportElement x="0" y="80" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="11"/>
                </textElement>
                <text><![CDATA[Campus Clinic Appointment Management System]]></text>
            </staticText>
            
            <!-- Date Range -->
            <textField>
                <reportElement x="420" y="100" width="135" height="15"/>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Period: " + $P{startDate} + " to " + $P{endDate}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
    <!-- Page Header -->
    <pageHeader>
        <band height="30">
            <!-- Separator Line -->
            <line>
                <reportElement x="0" y="25" width="555" height="1" />
            </line>
            
            <!-- Header Text -->
            <staticText>
                <reportElement x="0" y="5" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[APPOINTMENT SUMMARY REPORT]]></text>
            </staticText>
        </band>
    </pageHeader>
    
    <!-- Summary Section -->
    <summary>
        <band height="400">
            <!-- Section Title -->
            <staticText>
                <reportElement x="20" y="20" width="200" height="25"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[Statistics Summary]]></text>
            </staticText>
            
            <!-- Separator -->
            <line>
                <reportElement x="20" y="50" width="515" height="1"/>
            </line>
            
            <!-- Total Appointments -->
            <staticText>
                <reportElement x="40" y="70" width="200" height="25"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Total Appointments:]]></text>
            </staticText>
            <textField>
                <reportElement x="300" y="70" width="100" height="25"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{totalAppointments}]]></textFieldExpression>
            </textField>
            
            <!-- Pending -->
            <staticText>
                <reportElement x="40" y="100" width="200" height="25"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Pending:]]></text>
            </staticText>
            <textField>
                <reportElement x="300" y="100" width="100" height="25"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{pending}]]></textFieldExpression>
            </textField>
            
            <!-- Approved -->
            <staticText>
                <reportElement x="40" y="130" width="200" height="25"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Approved:]]></text>
            </staticText>
            <textField>
                <reportElement x="300" y="130" width="100" height="25"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{approved}]]></textFieldExpression>
            </textField>
            
            <!-- Completed -->
            <staticText>
                <reportElement x="40" y="160" width="200" height="25"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Completed:]]></text>
            </staticText>
            <textField>
                <reportElement x="300" y="160" width="100" height="25"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{completed}]]></textFieldExpression>
            </textField>
            
            <!-- Cancelled -->
            <staticText>
                <reportElement x="40" y="190" width="200" height="25"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Cancelled:]]></text>
            </staticText>
            <textField>
                <reportElement x="300" y="190" width="100" height="25"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{cancelled}]]></textFieldExpression>
            </textField>
            
            <!-- Separator -->
            <line>
                <reportElement x="20" y="230" width="515" height="1"/>
            </line>
            
            <!-- Footer Info -->
            <staticText>
                <reportElement x="20" y="250" width="200" height="20"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Generated By:]]></text>
            </staticText>
            <textField>
                <reportElement x="220" y="250" width="200" height="20"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{generatedBy}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="270" width="200" height="20"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Generated At:]]></text>
            </staticText>
            <textField>
                <reportElement x="220" y="270" width="200" height="20"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{generatedAt}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>